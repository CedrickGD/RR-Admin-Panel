# Copy to .env on the NAS. Never commit the real file.
DOMAIN=razorreaper.example
TUNNEL_TOKEN=            # Zero Trust -> Tunnels -> rr-nas -> token
# Discord bot (same values as on Railway today)
TOKEN=
NOTIFIER_TOKEN=
NOTIFIER_CHANNELS={}
NOTIFIER_MESSAGE_CONTENT=true
VERIFY_API_BASE=https://rr-admin-panel.pages.dev
VERIFY_SHARED_SECRET=
VERIFIED_ROLE_ID=
VERIFY_CHANNEL_ID=
# paths on the NAS
MEDIA_DIR=/volume1/razorreaper/media
DATA_DIR=/volume1/razorreaper/data
BACKUP_DIR=/volume1/razorreaper/backups
BOT_SRC=/volume1/razorreaper/src/razorreaper-bot
