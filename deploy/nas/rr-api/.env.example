# rr-api environment — copy to deploy/nas/rr-api/.env on the NAS (compose reads it via env_file).
# Never commit the real file. Everything here is passed through to the handlers unchanged; the
# list mirrors the env tables in the repo README + the worker's wrangler vars.

# ── Process ────────────────────────────────────────────────────────────────────
PORT=8787
# HOST=0.0.0.0
DB_PATH=/data/db/rr.sqlite
# Run schema.sql on an EMPTY database at first start (skip when you import a D1 export instead).
DB_BOOTSTRAP_SCHEMA=false
# SCHEMA_PATH=/app/schema.sql
# Nightly expired-license cleanup (worker.scheduled), container local time (UTC unless TZ is set; matches the old Workers cron).
CRON_LICENSE_CLEANUP=30 3 * * *
# In-process stand-ins for the RL_INGEST / RL_REGISTER rate-limit bindings (per cf-connecting-ip).
RL_INGEST_PER_MINUTE=60
RL_REGISTER_PER_MINUTE=5

# ── Ingest / install signing ───────────────────────────────────────────────────
# Shared legacy ingest key; the worker reads APP_SHARED_KEY (falls back to INGEST_TOKEN), the
# Pages ingest path reads INGEST_TOKEN (bearer) / TELEMETRY_APP_KEY (x-app-key).
APP_SHARED_KEY=
INGEST_TOKEN=
TELEMETRY_APP_KEY=
LEGACY_INGEST_KEY_ENABLED=true
REQUIRE_INSTALL_SIGNATURE=false

# ── Dashboard auth (Cloudflare Access in front of api.<domain>/api/admin/*) ─────
AUTH_MODE=access
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
ACCESS_ALLOWED_EMAIL=
ACCESS_ADMIN_EMAIL=
ACCESS_ENFORCEMENT=strict
# AUTH_MODE=app only:
JWT_SECRET=
AUTH_SESSION_COOKIE=rr_session

# ── Store / licenses ───────────────────────────────────────────────────────────
STORE_SECRET_KEY=

# ── Discord verification ───────────────────────────────────────────────────────
VERIFY_SHARED_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VERIFIED_ROLE_ID=
DISCORD_REDIRECT_URI=

# ── Media proxy (/media/*) ─────────────────────────────────────────────────────
# Upstream for the legacy /media/* route (default: the NAS caddy via the tunnel).
MEDIA_ORIGIN=https://media.razorreaper.app

# ── Update proxy (/update/*) ───────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_REPO=CedrickGD/RazorReaper
GITHUB_BRANCH=master
UPDATE_ASSET_NAME=RazorReaper-Setup.exe

# ── Informational ──────────────────────────────────────────────────────────────
BUILD_SHA=
