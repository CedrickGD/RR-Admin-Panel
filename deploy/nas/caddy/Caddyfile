# Static media origin behind the Cloudflare Tunnel. Cloudflare terminates TLS; Caddy serves plain HTTP
# on the docker network only. Directory listing is off; every object is immutable-by-convention
# (new media ships under a new filename), so long cache headers are safe.
:8080 {
	root * /srv/media
	@notfound not file
	respond @notfound 404
	header Cache-Control "public, max-age=86400, s-maxage=86400"
	header Access-Control-Allow-Origin "*"
	header -Server
	file_server {
		hide .*
	}
}
