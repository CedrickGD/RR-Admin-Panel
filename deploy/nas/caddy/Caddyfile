# Static media origin behind the Cloudflare Tunnel. Cloudflare terminates TLS; Caddy serves plain HTTP
# on the docker network only. Directory listing is off; every object is immutable-by-convention
# (new media ships under a new filename), so long cache headers are safe.
:8080 {
	# Stable public installer URL used by the website and Discord Rich Presence.
	# rr-api resolves the current GitHub release and returns the short-lived asset redirect.
	@download {
		host dl.razorreaper.app
		method GET
		path /
	}
	handle @download {
		header Cache-Control "no-store"
		rewrite * /update/download/free
		reverse_proxy rr-api:8787
	}

	# The desktop updater fetches its manifest and installer here; rr-api rewrites the manifest's
	# <url> and <changelog> to this host on the way out. No Cache-Control from Caddy: rr-api already
	# sends public, max-age=120 for the manifest and no-store for the download redirect.
	@updateProxy {
		host dl.razorreaper.app
		method GET HEAD
		path /update/*
	}
	handle @updateProxy {
		reverse_proxy rr-api:8787 {
			header_up X-Forwarded-Proto https
		}
	}

	# Public release notes (the <changelog> target and the Discord post link), so a customer never
	# needs repo access. rr-api sends public, max-age=600 itself.
	@releaseNotes {
		host dl.razorreaper.app
		method GET HEAD
		path /release-notes/*
	}
	handle @releaseNotes {
		reverse_proxy rr-api:8787 {
			header_up X-Forwarded-Proto https
		}
	}

	# Do not expose the media origin through arbitrary paths or methods on the download host.
	@downloadNotFound host dl.razorreaper.app
	handle @downloadNotFound {
		header Cache-Control "no-store"
		respond 404
	}

	handle {
		root * /srv/media
		@notfound not file
		respond @notfound 404
		header Cache-Control "public, max-age=86400, s-maxage=86400"
		header Access-Control-Allow-Origin "*"
		file_server {
			hide .*
		}
	}

	header -Server
}
