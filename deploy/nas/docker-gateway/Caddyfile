# Path allowlist between rr-api and the Docker socket proxy (compose service `docker-proxy`).
#
# tecnativa/docker-socket-proxy gates whole API *sections*, not paths: CONTAINERS=1 allows every
# non-POST call under /containers, for every container on the host. That includes
# /containers/<any>/json (inspect), /containers/<any>/archive?path=... (any file in any
# container, e.g. the tunnel credentials), /logs, /top, /changes, and the NAS's unrelated
# containers. rr-api is the internet-facing service behind the tunnel, so it must not be able to
# ask for any of that. This gateway is the path-level allowlist the socket proxy cannot be; it is
# the only service left on the docker-proxy network.
#
# Inspect is blocked for EVERY container, this project's included. `GET /containers/<name>/json`
# returns Config.Env verbatim, and every service here has secrets in its env file: admin.env
# holds ORIGIN_KEY, rr-api.env holds 35 values (the ingest tokens, the app keys, JWT_SECRET),
# bot.env holds the Discord TOKEN and the NOTIFIER_*/VERIFY_* values. The same payload also
# carries HostConfig and Mounts — the host's directory layout and every bind mount. None of that
# is health data, and letting the internet-facing service read it is a privilege escalation even
# for its own container. Caddy cannot reliably strip fields out of a proxied JSON body, so the
# route is refused rather than filtered.
#
# ALLOWED — exactly two GET shapes:
#   GET /containers/json                            -> /containers/json?all=1&filters=<project>
#   GET /containers/razorreaper-<service>-<n>/stats -> same path, ?stream=false forced
# REJECTED with 403 before the socket proxy is touched — everything else, including
#   /containers/<any>/json                   (inspect, for every container without exception)
#   /containers/<any>/archive|logs|export|top|changes|wait|attach
#   /containers/homeassistant-app-1/stats    (any container outside this compose project)
#   /images/*, /info, /version, /_ping, /networks/*, /volumes/*
#   every non-GET method, on every path.
#
# What the System health page gives up for this: State.StartedAt and RestartCount, which only
# inspect reports. State, the healthcheck verdict and an approximate uptime all come out of the
# list entry's `Status` string ("Up 3 minutes (healthy)"); restart counts are not collected at
# all and the page prints "—" for them. See functions/_lib/container-health.ts.
{
	admin off
}

:2375 {
	# The container list, forced to this compose project, so rr-api never learns which unrelated
	# containers the NAS runs. `filters` is percent-encoded because a Caddyfile reads { } as
	# placeholders; decoded it is {"label":["com.docker.compose.project=razorreaper"]}.
	@list {
		method GET
		path /containers/json
	}
	handle @list {
		rewrite * /containers/json?all=1&filters=%7B%22label%22%3A%5B%22com.docker.compose.project%3Drazorreaper%22%5D%7D
		reverse_proxy docker-proxy:2375
	}

	# One-shot CPU/memory. The stats payload carries no configuration and no environment, so every
	# container of this project is allowed; stream=false is forced so a caller cannot hold the
	# socket open. Anchored at both ends: nothing may follow `stats`.
	@stats {
		method GET
		path_regexp stats ^/containers/razorreaper-[a-z0-9][a-z0-9-]*-[0-9]+/stats$
	}
	handle @stats {
		rewrite * {http.request.uri.path}?stream=false
		reverse_proxy docker-proxy:2375
	}

	# Everything else, including every inspect path and every non-GET method.
	handle {
		respond "docker-gateway: endpoint not allowed" 403
	}

	header -Server
}
