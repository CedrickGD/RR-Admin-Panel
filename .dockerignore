**/dist
**/coverage
**/.env
**/.env.*
!**/.env.example
**/.dev.vars
**/*.sqlite
**/*.sqlite-shm
**/*.sqlite-wal
**/*.log
docs
plans
public
src
tests
tools
README.md
*.md
