# Compose variables (paths only — no secrets). Copy to .env next to compose.yml on the NAS.
DOMAIN=razorreaper.app
MEDIA_DIR=/volume1/docker/razorreaper/media
DATA_DIR=/volume1/docker/razorreaper/data
BACKUP_DIR=/volume1/docker/razorreaper/backups
BOT_SRC=/volume1/docker/razorreaper/src/razorreaper-bot

# Secrets live OUTSIDE the source mirror:
#   ${DATA_DIR}/env/bot.env        -> see bot.env.example
#   ${DATA_DIR}/env/rr-api.env     -> see rr-api/.env.example
#   ${DATA_DIR}/cloudflared/<tunnel-id>.json -> created by `cloudflared tunnel create rr-nas`
