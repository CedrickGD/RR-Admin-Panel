{
  "name": "rr-admin-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.pages-worker.config.ts",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --compatibility-date 2026-02-25 --kv KV",
    "dev:pages": "npm run build && npm run pages:dev",
    "typecheck": "tsc --noEmit",
    "hash:admin": "node tools/generate-admin-hash.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format:check": "prettier --check \"functions/**/*.ts\" \"backend-worker/**/*.js\" \"shared/**/*.ts\" \"tests/**/*.ts\"",
    "check": "npm run typecheck && npm run test && npm run build",
    "deploy:nas": "powershell -ExecutionPolicy Bypass -File tools/deploy-nas.ps1"
  },
  "dependencies": {
    "lucide-react": "^0.553.0",
    "maplibre-gl": "^5.20.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.15.18",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wrangler": "^4.6.0",
    "vitest": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "prettier": "3.7.4"
  }
}
